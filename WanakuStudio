<script>
/* ===== CONFIGURACIÓN ===== */
var WA_NUMBER = "51964737557"; // código de país + número, sin + ni espacios
var WA_MESSAGE = "Hola, vi su anuncio y quiero atraer más clientes para mi negocio.";
/* ID de conversión de Google Ads (opcional): "AW-XXXXXXXXX/XXXXXXXX" */
var GADS_CONVERSION = "";

function waLink(text){return "https://wa.me/"+WA_NUMBER+"?text="+encodeURIComponent(text)}
function track(src){
  try{
    if(typeof gtag==="function"){
      gtag("event","whatsapp_click",{event_category:"lead",event_label:src});
      if(GADS_CONVERSION){gtag("event","conversion",{send_to:GADS_CONVERSION})}
    }
  }catch(e){}
}
document.querySelectorAll(".js-wa").forEach(function(a){
  a.href=waLink(WA_MESSAGE);
  a.target="_blank";
  a.rel="noopener";
  a.addEventListener("click",function(){track(a.getAttribute("data-src")||"cta")});
});
document.getElementById("lead-form").addEventListener("submit",function(e){
  e.preventDefault();
  var n=this.nombre.value.trim(), b=this.negocio.value.trim();
  var err=document.getElementById("err");
  if(!n||!b){err.style.display="block";return}
  err.style.display="none";
  var msg="Hola, soy "+n+" de "+b+". Necesito: "+this.necesidad.value+". Vi su anuncio y quiero atraer más clientes.";
  track("formulario");
  window.open(waLink(msg),"_blank","noopener");
});
document.getElementById("y").textContent=new Date().getFullYear();
</script>
