<style>
:root{
  --terracota:#C4623F;
  --terracota-dark:#A94E2E;
  --arena:#F6EBD9;
  --arena-2:#EFDFC6;
  --menta:#BFE3CC;
  --turquesa:#1F8A8C;
  --pizarra:#243447;
  --pizarra-2:#2E4057;
  --texto:#2A2F38;
  --blanco:#FFFDF9;
  --radius:18px;
  --shadow:0 10px 30px rgba(36,52,71,.12);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',system-ui,sans-serif;color:var(--texto);background:var(--blanco);line-height:1.6;font-size:17px;-webkit-font-smoothing:antialiased;padding-bottom:84px}
h1,h2,h3{font-family:'Bricolage Grotesque','DM Sans',sans-serif;line-height:1.1;color:var(--pizarra);letter-spacing:-.02em}
img,svg{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1120px,100% - 40px);margin-inline:auto}
section{padding:72px 0}
.eyebrow{display:inline-block;font-weight:700;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--turquesa);margin-bottom:14px}
h2{font-size:clamp(1.9rem,4.6vw,2.9rem);font-weight:800;margin-bottom:16px}
.lead{font-size:1.1rem;max-width:620px;color:#47505c}

/* Botones */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--terracota);color:#fff;font-weight:700;font-size:1.05rem;text-decoration:none;padding:17px 30px;border-radius:999px;border:0;cursor:pointer;min-height:54px;box-shadow:0 8px 20px rgba(196,98,63,.35);transition:transform .15s,background .15s}
.btn:hover{background:var(--terracota-dark);transform:translateY(-2px)}
.btn:focus-visible,summary:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--turquesa);outline-offset:3px}
.btn svg{width:22px;height:22px;flex:none}
.btn-block{width:100%}
.micro{font-size:.9rem;color:#5b6572;margin-top:12px}

/* Barra superior */
header{position:sticky;top:0;z-index:20;background:rgba(255,253,249,.92);backdrop-filter:blur(8px);border-bottom:1px solid rgba(36,52,71,.08)}
.bar{display:flex;align-items:center;justify-content:space-between;height:64px}
.brand{display:flex;align-items:center;gap:10px;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:1.2rem;color:var(--pizarra);text-decoration:none}
.sun{width:30px;height:30px}
.bar .btn{padding:10px 20px;min-height:44px;font-size:.95rem;box-shadow:none}

/* Hero */
.hero{background:linear-gradient(180deg,var(--arena) 0%,var(--blanco) 100%);padding:48px 0 64px;overflow:hidden}
.hero-grid{display:grid;gap:40px;align-items:center}
.tag{display:inline-block;background:var(--menta);color:var(--pizarra);font-weight:700;font-size:.82rem;padding:6px 14px;border-radius:999px;margin-bottom:18px}
.hero h1{font-size:clamp(2.2rem,7vw,3.9rem);font-weight:800;margin-bottom:18px}
.hero h1 em{font-style:normal;color:var(--terracota)}
.hero .sub{font-size:1.15rem;color:#38414d;margin-bottom:22px;max-width:560px}
.checks{list-style:none;display:grid;gap:12px;margin-bottom:28px}
.checks li{display:flex;gap:12px;align-items:flex-start;font-weight:500}
.checks .ic{flex:none;width:26px;height:26px;border-radius:50%;background:var(--turquesa);display:grid;place-items:center;margin-top:1px}
.checks .ic svg{width:14px;height:14px;stroke:#fff;stroke-width:3;fill:none}
.for{margin-top:18px;font-size:.95rem;color:#47505c;border-left:3px solid var(--terracota);padding-left:12px}

/* Mock teléfono */
.phone-wrap{position:relative;display:flex;justify-content:center}
.blob{position:absolute;inset:8% 6%;background:var(--menta);border-radius:42% 58% 55% 45%/50% 45% 55% 50%;z-index:0}
.phone{position:relative;z-index:1;width:min(270px,70vw);aspect-ratio:9/17;background:var(--pizarra);border-radius:34px;padding:10px;box-shadow:var(--shadow);transform:rotate(3deg)}
.screen{height:100%;border-radius:26px;background:linear-gradient(160deg,var(--turquesa),var(--pizarra-2) 70%);position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;padding:18px;color:#fff}
.screen .sunbig{position:absolute;top:-30px;right:-30px;width:150px;height:150px;border-radius:50%;background:var(--terracota);opacity:.95}
.screen .arc{position:absolute;left:-40px;top:70px;width:200px;height:200px;border-radius:50%;border:16px solid var(--menta);opacity:.35}
.play{position:absolute;top:42%;left:50%;transform:translate(-50%,-50%);width:62px;height:62px;border-radius:50%;background:rgba(255,255,255,.95);display:grid;place-items:center}
.play svg{width:24px;height:24px;margin-left:3px;fill:var(--terracota)}
.cap{position:relative;font-weight:700;font-size:1.05rem;line-height:1.25;margin-bottom:12px;font-family:'Bricolage Grotesque',sans-serif}
.bubble{position:relative;background:#fff;color:var(--texto);border-radius:14px 14px 14px 4px;padding:10px 12px;font-size:.78rem;line-height:1.35;box-shadow:0 6px 16px rgba(0,0,0,.2)}
.bubble b{display:block;color:var(--turquesa);font-size:.7rem;margin-bottom:2px}
.ilus{position:absolute;bottom:-4px;left:50%;transform:translateX(-50%);font-size:.72rem;color:#5b6572;white-space:nowrap;z-index:2}

/* Beneficios */
.cards{display:grid;gap:18px;margin-top:36px}
.card{background:var(--arena);border-radius:var(--radius);padding:28px}
.card .n{width:46px;height:46px;border-radius:14px;background:var(--pizarra);display:grid;place-items:center;margin-bottom:16px}
.card .n svg{width:24px;height:24px;stroke:var(--menta);stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}
.card h3{font-size:1.3rem;font-weight:800;margin-bottom:8px}
.card p{color:#3d4652}
.strip{text-align:center;margin-top:36px}
.strip p{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(1.3rem,3vw,1.8rem);color:var(--pizarra);margin-bottom:18px}

/* Cómo funciona */
.dark{background:var(--pizarra);color:#e9eef3}
.dark h2,.dark h3{color:#fff}
.dark .eyebrow{color:var(--menta)}
.dark .lead{color:#c4ced9}
.steps{list-style:none;display:grid;gap:14px;margin-top:36px;counter-reset:s}
.steps li{counter-increment:s;background:var(--pizarra-2);border-radius:var(--radius);padding:22px 22px 22px 78px;position:relative}
.steps li::before{content:counter(s);position:absolute;left:20px;top:20px;width:42px;height:42px;border-radius:50%;background:var(--terracota);color:#fff;font-weight:800;display:grid;place-items:center;font-family:'Bricolage Grotesque',sans-serif;font-size:1.1rem}
.steps h3{font-size:1.1rem;margin-bottom:4px}
.steps p{color:#c4ced9;font-size:.98rem}
.inc{margin-top:44px;display:grid;gap:12px}
.inc h3{font-size:1.25rem;margin-bottom:6px}
.pills{display:flex;flex-wrap:wrap;gap:10px}
.pills span{background:rgba(191,227,204,.14);border:1px solid rgba(191,227,204,.4);color:#fff;padding:9px 16px;border-radius:999px;font-size:.95rem;font-weight:500}

/* Por qué */
.why{display:grid;gap:36px}
.why-list{display:grid;gap:18px}
.why-item{display:flex;gap:16px}
.why-item .dot{flex:none;width:12px;height:12px;border-radius:50%;background:var(--terracota);margin-top:9px}
.why-item h3{font-size:1.1rem;font-weight:800;margin-bottom:2px}
.why-item p{color:#47505c;font-size:.98rem}
.vs{background:var(--arena);border-radius:var(--radius);padding:24px;overflow:hidden}
.vs h3{font-size:1.1rem;margin-bottom:14px}
.vs table{width:100%;border-collapse:collapse;font-size:.92rem}
.vs th,.vs td{text-align:left;padding:11px 10px;border-bottom:1px solid rgba(36,52,71,.12);vertical-align:top}
.vs th{font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:#5b6572}
.vs td:last-child{font-weight:700;color:var(--turquesa)}
.vs tr:last-child td{border-bottom:0}

/* Confianza */
.trust{background:var(--arena)}
.tgrid{display:grid;gap:16px;margin-top:32px}
.tcard{background:var(--blanco);border-radius:var(--radius);padding:24px;border:1px solid rgba(36,52,71,.08)}
.tcard h3{font-size:1.08rem;font-weight:800;margin-bottom:6px}
.tcard p{font-size:.96rem;color:#47505c}
.honest{margin-top:28px;font-family:'Bricolage Grotesque',sans-serif;font-size:1.25rem;font-weight:700;color:var(--pizarra);max-width:720px}

/* FAQ */
.faq{max-width:780px;margin-top:32px}
details{border-bottom:1px solid rgba(36,52,71,.15);padding:4px 0}
summary{cursor:pointer;font-weight:700;font-size:1.08rem;padding:18px 36px 18px 0;list-style:none;position:relative;color:var(--pizarra)}
summary::-webkit-details-marker{display:none}
summary::after{content:'+';position:absolute;right:4px;top:50%;transform:translateY(-50%);font-size:1.6rem;color:var(--terracota);font-weight:500;transition:transform .2s}
details[open] summary::after{content:'−'}
details p{padding:0 0 20px;color:#47505c}

/* Cierre */
.close{background:linear-gradient(135deg,var(--terracota) 0%,#B04F30 100%);color:#fff;position:relative;overflow:hidden}
.close::before{content:'';position:absolute;right:-80px;top:-80px;width:280px;height:280px;border-radius:50%;background:rgba(255,255,255,.12)}
.close h2{color:#fff}
.close .lead{color:#fff5ec}
.close-grid{display:grid;gap:36px;position:relative}
.close .btn{background:var(--pizarra);box-shadow:0 8px 20px rgba(0,0,0,.25)}
.close .btn:hover{background:#1a2736}
.close .micro{color:#ffe9dc}
.form{background:var(--blanco);color:var(--texto);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow)}
.form h3{font-size:1.2rem;margin-bottom:4px}
.form .small{font-size:.9rem;color:#5b6572;margin-bottom:16px}
label{display:block;font-weight:700;font-size:.9rem;margin:12px 0 6px;color:var(--pizarra)}
input,select{width:100%;font:inherit;padding:14px;border-radius:12px;border:1.5px solid #cfd5dc;background:#fff;color:var(--texto);min-height:50px}
.form .btn{margin-top:18px;background:var(--terracota)}
.form .btn:hover{background:var(--terracota-dark)}
.err{color:#b3261e;font-size:.85rem;margin-top:6px;display:none}

footer{background:var(--pizarra);color:#c4ced9;padding:40px 0 20px;font-size:.92rem}
.fgrid{display:grid;gap:20px}
footer a{text-decoration:underline;text-underline-offset:3px}
.fine{margin-top:28px;padding-top:18px;border-top:1px solid rgba(255,255,255,.12);font-size:.82rem;color:#93a1b1}

/* Botón fijo móvil */
.sticky{position:fixed;left:0;right:0;bottom:0;z-index:30;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:rgba(255,253,249,.96);backdrop-filter:blur(8px);border-top:1px solid rgba(36,52,71,.1)}
.sticky .btn{width:100%}

@media(min-width:760px){
  body{padding-bottom:0}
  .sticky{display:none}
  section{padding:96px 0}
  .hero{padding:72px 0 88px}
  .hero-grid{grid-template-columns:1.15fr .85fr}
  .cards{grid-template-columns:repeat(2,1fr)}
  .steps{grid-template-columns:repeat(2,1fr)}
  .why{grid-template-columns:1fr 1fr;align-items:start}
  .tgrid{grid-template-columns:repeat(2,1fr)}
  .close-grid{grid-template-columns:1fr 1fr;align-items:center}
  .fgrid{grid-template-columns:1.2fr 1fr 1fr}
}
@media(min-width:1000px){
  .cards{grid-template-columns:repeat(4,1fr)}
  .tgrid{grid-template-columns:repeat(4,1fr)}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
